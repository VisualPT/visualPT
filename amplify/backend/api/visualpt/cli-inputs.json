{
  "version": 1,
  "serviceConfiguration": {
    "apiName": "visualpt",
    "serviceName": "AppSync",
    "defaultAuthType": {
      "mode": "API_KEY",
      "expirationTime": 365,
      "apiKeyExpirationDate": "2024-05-30T04:17:24.551Z",
      "keyDescription": "api key description"
    },
    "additionalAuthTypes": [
      {
        "mode": "AMAZON_COGNITO_USER_POOLS",
        "cognitoUserPoolId": "authvisualpt"
      },
      {
        "mode": "AWS_IAM"
      }
    ],
    "conflictResolution": {
      "defaultResolutionStrategy": {
        "type": "AUTOMERGE"
      }
    }
  }
}